# Qrail documented API base URL. Keep the API key server-side in Railway Variables.
RAILWAY_PROVIDER_BASE_URL=https://qrail.in/api
RAILWAY_PROVIDER_API_KEY=
# Qrail's published running-status example places the key in the path:
# RAILWAY_LIVE_STATUS_PATH=v3/trains/running/{train_number}/today/{api_key}
# Running Status is listed under Qrail Pro; confirm your plan before enabling it.
# Do not fill other paths until their exact routes and parameters are confirmed
# from your account's API documentation.
RAILWAY_PROVIDER_AUTH_HEADER=Authorization
RAILWAY_PROVIDER_AUTH_SCHEME=Bearer
RAILWAY_SEARCH_PATH=
RAILWAY_STATION_SEARCH_PATH=
RAILWAY_PNR_PATH=
RAILWAY_LIVE_STATUS_PATH=
RAILWAY_AVAILABILITY_PATH=
# Optional shared infrastructure
REDIS_URL=
CORS_ORIGINS=https://railnova-phi.vercel.app,https://railnova-srujan3208-2877s-projects.vercel.app
REQUEST_TIMEOUT_SECONDS=12
RATE_LIMIT_PER_MINUTE=90
