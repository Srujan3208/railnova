# Qrail API host shown in the account API documentation.
# Endpoint paths below include /api/v1; do not append /api to this base URL.
# Keep the API key server-side in Railway Variables.
RAILWAY_PROVIDER_BASE_URL=https://api.qrail.in
RAILWAY_PROVIDER_API_KEY=
# Confirmed from Qrail account documentation: POST JSON {"train": <train_number>}.
RAILWAY_TRAIN_DETAILS_PATH=api/v1/trains/details
RAILWAY_LIVE_STATUS_PATH=api/v1/trains/running/status
# PNR documentation screenshot showed a "train" example payload, not a PNR payload.
# Leave PNR unset until Qrail confirms the required PNR request body.
RAILWAY_PROVIDER_AUTH_HEADER=Authorization
RAILWAY_PROVIDER_AUTH_SCHEME=Bearer
RAILWAY_SEARCH_PATH=
RAILWAY_STATION_SEARCH_PATH=
RAILWAY_PNR_PATH=
RAILWAY_LIVE_STATUS_PATH=
RAILWAY_AVAILABILITY_PATH=
# Optional shared infrastructure
REDIS_URL=
CORS_ORIGINS=https://railnova-phi.vercel.app,https://railnova-srujan3208-2877s-projects.vercel.app
REQUEST_TIMEOUT_SECONDS=12
RATE_LIMIT_PER_MINUTE=90
